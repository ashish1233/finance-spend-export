# Copy to .env for local development. .env is gitignored and must stay that way.

INSIGHTS_TENANT_ID=finance

# Assigned by the platform team (ADR-2). Standard tier: the warehouse role is
# the isolation backstop, audit is fail-open and buffers locally if the sink is
# down, and this job keeps running through a telemetry outage. That trade is
# deliberately *not* the one the restricted tier makes.
INSIGHTS_TIER=standard

# The job exchanges its deploy-time credential for a short-lived *service* token
# at POST {INSIGHTS_IDP_URL}/token/service. No user token appears anywhere in
# this job's life (ADR-1).
INSIGHTS_IDP_URL=http://localhost:8081
INSIGHTS_WAREHOUSE_URL=http://localhost:8082
INSIGHTS_AUDIT_URL=http://localhost:8083

# Demo affordance only. Seconds between runs so the job is observable; 0 means
# run once and exit, which is the shape a scheduler-driven deployment uses.
EXPORT_INTERVAL_SECONDS=30

# Local development only — the stub IdP signs with a shared secret. Real
# deployments verify against the corporate IdP's published keys and leave this
# unset.
# INSIGHTS_TOKEN_SECRET=dev-only-insecure-secret-replaced-by-the-idp-in-any-real-deployment
